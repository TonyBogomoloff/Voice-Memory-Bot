[Unit]
Description=Voice Memory Obsidian HTTPS tunnel
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/voice-memory-obsidian.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
